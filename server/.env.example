# Copy to .env (never commit .env). See README.md.

# From `claude setup-token` (one-year login to your Claude account). Required in Docker.
CLAUDE_CODE_OAUTH_TOKEN=

# Shared secret the app sends as "Authorization: Bearer ...". At least 16 characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AI_SECRET=

# Optional (defaults shown)
# AI_MODEL=sonnet
# ALLOWED_ORIGINS=https://zooksey.github.io,http://localhost:8766,http://127.0.0.1:8766
# PORT=8787
# AI_TIMEOUT_MS=85000
# AI_MAX_TURNS=10
